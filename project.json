{
  "langrev": "1",
  "warnings": ["no-unused"],
  "sources": [
    "src/**"
  ],
  "test-sources": ["test/**"],
  "targets": {
    "static-lib": {
      "type": "static-lib"
    },
    "debug": {
      "type": "static-lib",
      "opt": "O0"
    },
    "release": {
      "type": "static-lib",
      "opt": "O3"
    },
    "bench": {
      "type": "executable",
      "opt": "O3",
      "sources": ["src/**", "bench/**"]
    },
    "random-delaunay": {
      "type": "executable",
      "opt": "O3",
      "sources": ["src/**", "scripts/random_delaunay.c3"]
    }
  }
}
