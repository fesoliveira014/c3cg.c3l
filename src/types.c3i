module cg;

typedef HeIndex     = inline int;
typedef FaceIndex   = inline int;
typedef VertexIndex = inline int;

alias Vec2f = float[<2>];
alias Vec3f = float[<3>];
alias Vec4f = float[<4>];
alias Vec2i = int[<2>];
alias Vec3i = int[<3>];

const HeIndex     INVALID_HE     = -1;
const FaceIndex   INVALID_FACE   = -1;
const VertexIndex INVALID_VERTEX = -1;

struct Aabb {
    Vec3f min;
    Vec3f max;
}
